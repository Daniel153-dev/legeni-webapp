// TP 3.7 : contrôles qualité en parallèle, rapports de tests et quality gates
pipeline {
    agent any

    environment {
        IMAGE   = "legeni-webapp"
        VERSION = "1.0.${env.BUILD_NUMBER}"
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    stages {
        stage('Qualité du code') {
            parallel {
                stage('Tests unitaires') {
                    agent {
                        docker {
                            image 'python:3.12-slim'
                            args '-e HOME=/tmp'
                            reuseNode true
                        }
                    }
                    steps {
                        sh '''
                            python -m venv /tmp/venv
                            /tmp/venv/bin/pip install -q -r requirements.txt -r requirements-dev.txt
                            mkdir -p reports
                            /tmp/venv/bin/pytest --junitxml=reports/junit.xml \
                                --cov=app --cov-report=xml:reports/coverage.xml --cov-fail-under=80
                        '''
                    }
                    post {
                        always {
                            junit 'reports/junit.xml'
                            recordCoverage(tools: [[parser: 'COBERTURA', pattern: 'reports/coverage.xml']])
                        }
                    }
                }
                stage('Lint Python') {
                    agent {
                        docker {
                            image 'python:3.12-slim'
                            args '-e HOME=/tmp'
                            reuseNode true
                        }
                    }
                    steps {
                        sh 'python -m venv /tmp/venv'
                        // On installe flake8 et le plugin de formatage checkstyle pour générer du XML valide
                        sh '/tmp/venv/bin/pip install -q flake8==7.1.1 flake8-checkstyle==0.4.0'
                        sh 'mkdir -p reports'
                        // On génère le rapport au format checkstyle (XML) attendu par recordIssues
                        sh '/tmp/venv/bin/flake8 --format=checkstyle --output-file=reports/flake8-checkstyle.xml . || true'
                    }
                    post {
                        always {
                            // Analyse du fichier XML généré par le parser natif checkstyle
                            recordIssues(tools: [[parser: 'checkstyle', pattern: 'reports/flake8-checkstyle.xml']])
                        }
                    }
                }
                stage('Lint Dockerfile') {
                    steps {
                        sh 'docker run --rm -i hadolint/hadolint:v2.12.0 < Dockerfile'
                    }
                }
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build --build-arg APP_VERSION=$VERSION -t $IMAGE:$VERSION .'
            }
        }

        stage('Scan de sécurité') {
            steps {
                sh '''
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy_cache:/root/.cache \
                        aquasec/trivy:0.57.1 image --severity CRITICAL --ignore-unfixed --exit-code 1 $IMAGE:$VERSION
                '''
            }
        }
    }

    post {
        cleanup {
            cleanWs()
        }
    }
}